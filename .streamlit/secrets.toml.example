# Nemo AI - Secrets Configuration Example
# Duplicate this file as 'secrets.toml' in the .streamlit folder and insert your credentials.

# Google Gemini API Key (Required for AI planning & vision)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY = "your_google_gemini_api_key_here"

# Optional: Twilio WhatsApp Sandbox Credentials (for direct SMS/WhatsApp API delivery)
# If left blank, Nemo AI will still let you share plans via WhatsApp Direct Web Link or Clipboard!
TWILIO_ACCOUNT_SID = "your_twilio_account_sid_here"
TWILIO_AUTH_TOKEN = "your_twilio_auth_token_here"
TWILIO_WHATSAPP_FROM = "whatsapp:+14155238886"
TWILIO_CONTENT_SID = "your_twilio_content_sid_here"
